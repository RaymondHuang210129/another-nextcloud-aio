+package transcoder
+
+import (
+	"net/http/httptest"
+	"os/exec"
+	"strings"
+	"testing"
+	"time"
+)
+
+func renderTestPlaylist(t *testing.T, duration time.Duration) string {
+	t.Helper()
+	c := &Config{ChunkSize: 3, HLSCodec: CODEC_HEVC}
+	m := &Manager{c: c, probe: &ProbeVideoData{Duration: duration}}
+	s := &Stream{c: c, m: m, quality: QUALITY_MAX}
+	recorder := httptest.NewRecorder()
+	request := httptest.NewRequest("GET", "/max.m3u8", nil)
+	if err := s.ServeList(recorder, request); err != nil {
+		t.Fatal(err)
+	}
+	return recorder.Body.String()
+}
+
+func TestServeListMergesShortFinalTail(t *testing.T) {
+	playlist := renderTestPlaylist(t, 189353333*time.Microsecond)
+	if !strings.Contains(playlist, "#EXT-X-TARGETDURATION:4") {
+		t.Fatalf("HEVC target duration does not allow fragment variance:\n%s", playlist)
+	}
+	if !strings.Contains(playlist, "#EXTINF:3.353, nodesc\nmax-000062.m4s") {
+		t.Fatalf("playlist did not merge short final tail into segment 62:\n%s", playlist)
+	}
+	if strings.Contains(playlist, "max-000063.m4s") {
+		t.Fatalf("playlist advertised a short segment ffmpeg may not create:\n%s", playlist)
+	}
+}
+
+func TestServeListKeepsSubstantialFinalTail(t *testing.T) {
+	playlist := renderTestPlaylist(t, 190200000*time.Microsecond)
+	if !strings.Contains(playlist, "#EXTINF:1.200, nodesc\nmax-000063.m4s") {
+		t.Fatalf("playlist dropped substantial final tail:\n%s", playlist)
+	}
+}
+
+func TestServeListExactBoundary(t *testing.T) {
+	playlist := renderTestPlaylist(t, 189*time.Second)
+	if !strings.Contains(playlist, "#EXTINF:3.000, nodesc\nmax-000062.m4s") {
+		t.Fatalf("playlist dropped exact-boundary segment 62:\n%s", playlist)
+	}
+	if strings.Contains(playlist, "max-000063.m4s") {
+		t.Fatal("playlist added a segment beyond an exact duration boundary")
+	}
+}
+
+func TestMonitorExitClearsNormalProcess(t *testing.T) {
+	coder := exec.Command("true")
+	if err := coder.Start(); err != nil {
+		t.Fatal(err)
+	}
+	notif := make(chan bool, 1)
+	s := &Stream{
+		m:       &Manager{id: "test"},
+		quality: QUALITY_MAX,
+		coder:   coder,
+		chunks: map[int]*Chunk{
+			0: {id: 0, notifs: []chan bool{notif}},
+		},
+	}
+
+	s.monitorExit()
+
+	if s.coder != nil {
+		t.Fatal("normally exited encoder remained resumable")
+	}
+	select {
+	case <-notif:
+	default:
+		t.Fatal("waiting chunk was not notified when encoder exited")
+	}
+}
+
+func TestCanWaitForChunkRequiresRunningEncoder(t *testing.T) {
+	s := &Stream{
+		c: &Config{LookBehind: 3},
+		chunks: map[int]*Chunk{
+			2: {id: 2, done: true},
+			3: {id: 3},
+		},
+	}
+
+	if s.canWaitForChunk(3) {
+		t.Fatal("unfinished chunk was considered pending without an encoder")
+	}
+	if s.canWaitForChunk(4) {
+		t.Fatal("nearby chunk was considered pending without an encoder")
+	}
+
+	s.coder = exec.Command("true")
+	if !s.canWaitForChunk(3) {
+		t.Fatal("unfinished chunk was not considered pending with an encoder")
+	}
+	if !s.canWaitForChunk(4) {
+		t.Fatal("nearby chunk was not considered pending with an encoder")
+	}
+}
